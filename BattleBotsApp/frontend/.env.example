# ============================================================================
# Frontend environment template — safe to commit. Copy to .env for overrides:
#
#   cp .env.example .env
#
# Never commit frontend/.env or .env.local (listed in .gitignore).
# Vite only exposes variables prefixed with VITE_ to the browser.
# ============================================================================

# FastAPI backend URL (optional).
# Leave unset in local dev — Vite proxies /api → http://127.0.0.1:8000 automatically.
# Set this only if the API runs on a different host/port.
# VITE_API_BASE=http://localhost:8000
