# ============================================================================
# Environment template — safe to commit. Copy to .env and add real secrets:
#
#   cp .env.example .env
#
# Never commit backend/.env (it is listed in .gitignore).
# ============================================================================

# ============================================================================
# Bright Data — Web Unlocker API
# ============================================================================
# 1. Sign up / log in at https://brightdata.com
# 2. Go to Proxies & Scraping Infrastructure -> Add -> Web Unlocker
# 3. Create a zone (e.g. "battlebots_unlocker"). Note the zone name.
# 4. Go to Account Settings -> API Tokens. Generate a new API token.
#
# The Web Unlocker API is called as:
#   POST https://api.brightdata.com/request
#   Authorization: Bearer <BRIGHTDATA_API_TOKEN>
#   Body: { "zone": "<BRIGHTDATA_WEB_UNLOCKER_ZONE>", "url": "...", "format": "raw" }
# ============================================================================
BRIGHTDATA_API_TOKEN=your_brightdata_api_token_here
BRIGHTDATA_WEB_UNLOCKER_ZONE=battlebots_unlocker

# Optional: country code to route requests from (e.g. "us", "gb"). Leave blank
# for the default residential rotation.
BRIGHTDATA_COUNTRY=us

# Request timeout in seconds for the Web Unlocker API.
BRIGHTDATA_TIMEOUT_SECONDS=90

# ============================================================================
# Storage
# ============================================================================
# Path to the SQLite database file (relative to the backend/ directory).
DATABASE_PATH=data/battlebots.db

# ============================================================================
# LLM provider (used in Phase 4 — prediction engine)
# ============================================================================
# Choose one provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ============================================================================
# Scraper behavior
# ============================================================================
# Seconds between Bright Data requests (be polite, avoid rate-limit penalties).
SCRAPER_REQUEST_DELAY_SECONDS=1.5

# Max posts + comments to keep per (bot, source) pair.
SENTIMENT_MAX_QUOTES=50

# Reddit scraping depth (more pages = more Bright Data requests per bot).
REDDIT_SEARCH_LIMIT=100
REDDIT_SEARCH_PAGES=2
REDDIT_COMMENT_POSTS=12
REDDIT_MAX_COMMENTS_PER_POST=30
REDDIT_SUBREDDITS=Battlebots,robotwars

# RAG — embed Reddit sentiment and retrieve relevant chunks at predict time.
# Requires OPENAI_API_KEY (uses text-embedding-3-small).
RAG_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K_PER_BOT=8

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
